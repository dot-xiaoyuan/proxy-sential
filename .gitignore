.DS_Store

# Build outputs
bin/
dist/
target/
coverage/
__pycache__/
*.py[cod]

# Runtime data
data/
tmp/
logs/
*.log
*.pcap
*.pcapng
eve.json
events.jsonl

# Local config
.env
.env.*
config.local.*
deploy/compose/storage.env
.gocache/
.worktrees/

# IDE
.idea/
.vscode/

# Embedded fingerprint rules are source assets, not runtime data.
!internal/fingerprint/data/
# The AI relay indicator asset is compiled in through //go:embed, so the generic
# data/ rule must not hide it from a fresh clone or worktree.
!internal/airelay/data/
