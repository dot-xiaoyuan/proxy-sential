# Copy to data/run/eventbus.env (ignored) or export these values.
# Pin the image tag/digest for your environment; never use a floating "latest".
REDPANDA_IMAGE=redpandadata/redpanda:v25.3.18
EVENTBUS_KAFKA_PORT=19092
EVENTBUS_ADMIN_PORT=19644
PROXY_SENTINEL_EVENTBUS_DATA_DIR=./data/eventbus
EVENTBUS_CPUS=1.0
EVENTBUS_MEM_LIMIT=1073741824
EVENTBUS_SMP=1
EVENTBUS_MEMORY=1G
# 可选：指向 discovery-worker 的 <spool>/stream-capture-stats/eventbus.stats
# EVENTBUS_STATS_PATH=/var/lib/proxy-sentinel/discovery-spool/stream-capture-stats/eventbus.stats
# 可选：避免与已有容器名冲突
# EVENTBUS_CONTAINER_NAME=proxy-sentinel-redpanda
