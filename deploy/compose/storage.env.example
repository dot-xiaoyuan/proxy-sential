# 只支持 Coding 镜像仓库中的不可变 digest，禁止 latest 和仅 tag 引用。
POSTGRES_IMAGE=srun-docker.pkg.coding.net/dpi/image/postgres@sha256:3a82e1f56c8f0f5616a11103ac3d47e632c3938698946a7ad26da0df1334744a
POSTGRES_IMAGE_VERSION=18.4
CLICKHOUSE_IMAGE=srun-docker.pkg.coding.net/dpi/image/clickhouse@sha256:bca6494fa85aea382ddf69e8b9e8b481d2f06603b083e3dd705013a8c260e91f
CLICKHOUSE_IMAGE_VERSION=25.9.2.1

CODING_REGISTRY=srun-docker.pkg.coding.net
CODING_REGISTRY_USERNAME=replace-me
CODING_REGISTRY_PASSWORD=replace-me

PROXY_SENTINEL_ROOT=/opt/proxy-sentinel
PROXY_SENTINEL_DATA_DIR=/opt/proxy-sentinel/data/db
PROXY_SENTINEL_STORAGE_MODE=db
PROXY_SENTINEL_CONTROL_ADDR=0.0.0.0:18080
PROXY_SENTINEL_HEALTH_URL=http://127.0.0.1:18080/readyz
PROXY_SENTINEL_SENSOR_ID=office-30
PROXY_SENTINEL_MIRROR_INTERFACE=ens1f1
PROXY_SENTINEL_READ_ONLY=false
PROXY_SENTINEL_MANAGE_SURICATA=true
PROXY_SENTINEL_MANAGE_ZEEK=true
PROXY_SENTINEL_INGEST_ENABLED=true
PROXY_SENTINEL_EVE_PATH=/var/log/suricata/eve.json
PROXY_SENTINEL_INGEST_POLL_INTERVAL=2s
PROXY_SENTINEL_INGEST_MAX_BATCH_BYTES=8388608
PROXY_SENTINEL_INGEST_STORE_TIMEOUT=2m
PROXY_SENTINEL_INGEST_HEARTBEAT_INTERVAL=30s
# Zeek 已在同机产生日志时按需设置；留空的来源不会传给 Ingest Worker。
PROXY_SENTINEL_ZEEK_DHCP_PATH=
PROXY_SENTINEL_ZEEK_SOFTWARE_PATH=
PROXY_SENTINEL_ZEEK_MDNS_PATH=
PROXY_SENTINEL_ZEEK_NBNS_PATH=
PROXY_SENTINEL_ZEEK_LLMNR_PATH=
PROXY_SENTINEL_ZEEK_TTL_PATH=

POSTGRES_HOST_PORT=25432
POSTGRES_DB=proxy_sentinel
POSTGRES_USER=proxy_sentinel
POSTGRES_PASSWORD=replace-with-a-long-random-password
PROXY_SENTINEL_POSTGRES_DSN='postgres://proxy_sentinel:replace-with-url-escaped-password@127.0.0.1:25432/proxy_sentinel?sslmode=disable'

CLICKHOUSE_HTTP_HOST_PORT=28123
CLICKHOUSE_NATIVE_HOST_PORT=29000
CLICKHOUSE_DB=proxy_sentinel
CLICKHOUSE_USER=proxy_sentinel
CLICKHOUSE_PASSWORD=replace-with-a-long-random-password
PROXY_SENTINEL_CLICKHOUSE_DSN='http://127.0.0.1:28123/?user=proxy_sentinel&password=replace-with-url-escaped-password&database=proxy_sentinel'

PROXY_SENTINEL_IDENTITY_INGEST_KEY=replace-with-a-long-random-token
PROXY_SENTINEL_ACTION_MASTER_KEY=replace-with-at-least-32-random-characters
PROXY_SENTINEL_ADMIN_USERNAME=admin
PROXY_SENTINEL_ADMIN_DISPLAY_NAME=系统管理员

# 至少 5 GiB；升级预检还会额外要求剩余空间大于当前数据库体积。
PROXY_SENTINEL_MIN_FREE_KB=5242880

# Device-service hypotheses are shown separately from confirmed device attributes.
PROXY_SENTINEL_BRAND_INFERENCE_ENABLED=true
