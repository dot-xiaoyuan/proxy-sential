# Handshake summary output (device-signal --handshake-only). The stream reader
# follows a verified numbered rotation chain. A dateext archive is invisible to
# that chain once the original inode has been compressed. Keep the recovery
# anchor and run the protector after each rotation before removing any alias.
/opt/proxy-sentinel/data/device-signals/handshake.jsonl {
  size 256M
  rotate 4
  missingok
  notifempty
  nocreate
  compress
  delaycompress
  nodateext
  postrotate
    if [ -d /opt/proxy-sentinel/data/handshake-source-recovery ]; then
      /usr/bin/python3 /opt/proxy-sentinel/current/scripts/protect_device_signal_rotations.py /opt/proxy-sentinel/data/device-signals/handshake.jsonl /opt/proxy-sentinel/data/handshake-source-recovery
    fi
  endscript
}
