# Router/TTL packet-sidecar output. The collector reopens this path with
# O_APPEND|O_CREATE for every bucket, and realtime ingest drains the rotated file
# by file identity before following the new one, so plain rename rotation loses
# no records and needs neither copytruncate nor a collector restart.
# delaycompress keeps the newest rotation readable for ingest until the next one.
# The distribution enables dateext globally, so an explicit clock-level
# dateformat is required: with the plain date stamp a second rotation on the same
# day would collide and be skipped, which is how this file grew to 125 GB.
/opt/proxy-sentinel/data/device-signals/ttl.jsonl {
  size 1G
  rotate 4
  missingok
  notifempty
  nocreate
  compress
  delaycompress
  dateformat -%Y%m%d-%H%M%S
}
