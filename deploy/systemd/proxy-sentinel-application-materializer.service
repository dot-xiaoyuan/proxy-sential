[Unit]
Description=Proxy Sentinel bounded realtime application classifier
After=network-online.target docker.service proxy-sentinel-ingest.service proxy-sentinel-read-model-realtime.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/proxy-sentinel
EnvironmentFile=/opt/proxy-sentinel/config/runtime.env
Environment=PROXY_SENTINEL_APPLICATION_HISTORY_DISABLED=true
ExecStart=/opt/proxy-sentinel/current/bin/proxy-sentinel read-model run --lane application --sensor-id ${PROXY_SENTINEL_SENSOR_ID} --applications-dir /opt/proxy-sentinel/data/applications --applications-bootstrap /opt/proxy-sentinel/current/assets/applications/bootstrap.tar.gz
Restart=on-failure
RestartSec=10
TimeoutStopSec=30s
KillSignal=SIGTERM
CPUQuota=75%
CPUWeight=30
MemoryHigh=768M
MemoryMax=1G
OOMPolicy=stop
Nice=10
IOWeight=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/proxy-sentinel/data/applications

[Install]
WantedBy=multi-user.target
