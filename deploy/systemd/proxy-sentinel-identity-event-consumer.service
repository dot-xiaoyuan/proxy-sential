[Unit]
Description=Proxy Sentinel identity session Kafka shadow consumer
After=network-online.target proxy-sentinel-eventbus-host.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/proxy-sentinel/config/runtime.env
Environment=PROXY_SENTINEL_EVENT_BUS_BROKERS=127.0.0.1:19092
ExecStart=/opt/proxy-sentinel/releases/2026.10.30-eventbus-p2/bin/identity-event-consumer --brokers=127.0.0.1:19092
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=65536
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
