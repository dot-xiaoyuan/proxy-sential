[Unit]
Description=Proxy Sentinel device inventory-backfill projection
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/proxy-sentinel
EnvironmentFile=/opt/proxy-sentinel/config/runtime.env
ExecStart=/opt/proxy-sentinel/current/bin/proxy-sentinel read-model run --lane inventory-backfill --sensor-id ${PROXY_SENTINEL_SENSOR_ID}
Restart=on-failure
RestartSec=2
TimeoutStopSec=30s
KillSignal=SIGTERM
CPUQuota=200%
CPUWeight=10
MemoryMax=1G
IOWeight=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
