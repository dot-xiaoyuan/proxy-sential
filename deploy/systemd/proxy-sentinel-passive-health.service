[Unit]
Description=Read-only health of the passive discovery site
After=docker.service proxy-sentinel-control-plane.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/proxy-sentinel/config/runtime.env
ExecStartPre=/usr/bin/mkdir -p /opt/proxy-sentinel/data/passive-health
ExecStart=/usr/bin/python3 /opt/proxy-sentinel/current/scripts/passive_health.py --journal --snapshot-file /opt/proxy-sentinel/data/passive-health/latest.json
TimeoutStartSec=100s
Nice=10
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=-/opt/proxy-sentinel/data/passive-health
ProtectHome=true
PrivateTmp=true
