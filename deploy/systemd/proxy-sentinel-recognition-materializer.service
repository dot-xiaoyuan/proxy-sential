[Unit]
Description=Proxy Sentinel endpoint recognition materializer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/proxy-sentinel
EnvironmentFile=/opt/proxy-sentinel/config/runtime.env
ExecStart=/opt/proxy-sentinel/current/bin/proxy-sentinel read-model run --lane recognition --sensor-id ${PROXY_SENTINEL_SENSOR_ID}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30s
KillSignal=SIGTERM
CPUQuota=100%
CPUWeight=40
MemoryHigh=768M
MemoryMax=1G
OOMPolicy=stop
Nice=8
IOWeight=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
