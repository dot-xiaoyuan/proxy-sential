[Unit]
Description=Proxy Sentinel incremental recognition coverage shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/proxy-sentinel/config/runtime.env
ExecStart=/opt/proxy-sentinel/releases/2026.10.30-eventbus-p2/bin/recognition-minute-shadow --interval=60s --lookback-minutes=10
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
LimitNOFILE=65536
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
