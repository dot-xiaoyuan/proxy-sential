[Unit]
Description=Rotate Proxy Sentinel shared-access and router signal logs

[Service]
Type=oneshot
ExecStart=/usr/sbin/logrotate --state /opt/proxy-sentinel/data/shared-logrotate.state /etc/logrotate.d/proxy-sentinel-shared-signals /opt/proxy-sentinel/config/logrotate/proxy-sentinel-router-signals /etc/logrotate.d/proxy-sentinel-flow-syn-signals
