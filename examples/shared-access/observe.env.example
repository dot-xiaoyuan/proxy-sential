# Append to the existing protected runtime configuration only during authorized deployment.
# Apply to ingest, identity ingestion, recognition materializer and control plane.
PROXY_SENTINEL_SHARED_OBSERVATION_ENABLED=true
PROXY_SENTINEL_SHARED_ACCESS_CONFIG=/opt/proxy-sentinel/config/shared-access-observe.json
# Keep the existing identity-source registration and all credentials.
# Control-plane and identity-sync systemd arguments MUST retain --read-only=true.
# No native action connector or notification configuration is required.
