  "rules": [
    {"id":"huawei-airengine","version":"2026-09-29.11","inputs":["hostname","vendor_class","software","lldp_system_name","lldp_system_description","http_server","http_title","tls_subject","tls_san"],"match":"regex","pattern":"\\b(AirEngine[- _A-Za-z0-9.]*|Huawei[- _]?AP[- _]?[A-Za-z0-9.]+)\\b","brand":"Huawei","series":"AirEngine/AP","model":"$1","role":"ap","strength":"strong","score":60,"exclude":false,"explanation":"Huawei AP/AirEngine 网络接入设备型号线索"},
